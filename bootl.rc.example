# bootl.rc - copie para a raiz do cartao SD como "bootl.rc" e descomente o que precisar.
# Uma chave por linha, no formato chave=valor. "#" e ";" comentam a linha inteira.
# O arquivo e lido logo depois de o cartao montar. Sem cartao, sem arquivo, ou com
# valor recusado, vale o padrao de src/board.h e a placa sobe igual.

# ---- Pinos do PS/2 ------------------------------------------------------------
# Padrao (LilyGO TTGO VGA32 / RobGo-RG): teclado em 32/33, mouse em 27/26.
# DATA e CLK andam em par: declarar um sem o outro faz os quatro voltarem ao padrao.
# Nao vale usar GPIO 34-39 aqui: eles so leem, e o PS/2 precisa escrever no pino.
#kbddat=32
#kbdclk=33
#mousedat=27
#mouseclk=26

# Perfil invertido (teclado na porta do mouse). Declarando so o teclado na porta B,
# o mouse assume a porta A sozinho, como no firmware antigo.
#kbddat=27
#kbdclk=26

# ---- Botao de menu -----------------------------------------------------------
# GPIO de um botao que abre o menu do fMSX, igual ao F10. Fecha para GND.
# Em 34-39 (como o 36) nao existe pull-up interno: precisa de resistor externo.
# Sem a chave, ou com magicb=-1, nenhum botao e usado.
#magicb=36

# ---- Emulador ----------------------------------------------------------------
# Diretorio que contem as BIOS no SD (padrao: /MSX2/ROMS).
#msx_biosdir=/MSX2/ROMS

# Cartucho e disquetes carregados ao ligar.
#msx_rom=/msx/jogo.rom
#msx_diska=/msx/disco.dsk
#msx_diskb=/msx/disco2.dsk

# Auto Frame Skip comeca LIGADO (AUTO) na v1.02. Shift+F11 alterna AUTO / 0%.
# Para iniciar desligado, descomente: 
#msx_autoskip=0
# Chave antiga msx_frameskip=0 tambem desliga; msx_autoskip tem prioridade.
#msx_frameskip=0

# Sintese FM (YM2413).
#msx_fm=1

# Contador de FPS no monitor serial.
#msx_fps=1

# MSX2+: tela de abertura real exige MSX2PKANJI.ROM (32768 bytes) em /MSX2/ROMS.
# Nao confundir com KANJI.ROM (fontes, 131072 bytes).
# MSX2+ porta F4h: auto detecta fabricantes; se a ROM usar outra polaridade:
# 1 = Panasonic/Sanyo (invertida), 0 = Sony/normal.
#msx_f4_inverted=0

# ---- v1.03: temporizacao das colisoes de sprites no logo original MSX2+ --
# Padrao 1 (ON): acompanha colisao por linha e a cada leitura de S#0.
# Atua apenas durante SCREEN 6 na abertura e nao custa FPS nos jogos.
# Se o logo continuar com problemas, compare com a v1.02 desativando:
#msx_boot_sprite_scanline=0

# ---- v1.04: rolagem horizontal V9958 na SCREEN6 do MSX2+ ----
# Desativada por padrao na v1.05: a v1.04 trouxe glitches graficos.
# Para repetir o experimento da v1.04 (apenas diagnostico):
# msx_v9958_screen6_scroll=1

# ---- v1.05: fim dos sprites-guia da abertura MSX2+ ----
# Ativado por padrao. A ROM real sinaliza fim por R#25=00 e R#2=1F.
# So para comparacao com v1.03: deixar as duas barras sem limpeza visual.
# msx_boot_guides_cleanup=0
